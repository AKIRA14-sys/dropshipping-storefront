# Public Supabase project settings only. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public URL used for metadata and sitemap; set after Vercel deployment.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Keep false while products, prices, delivery, support and policies are demo content.
NEXT_PUBLIC_STORE_LIVE=false
# Set true only after replacing demo content and checking the deployed storefront.
NEXT_PUBLIC_INDEXING_ENABLED=false
# Optional Google Search Console verification token; not a credential for app access.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
