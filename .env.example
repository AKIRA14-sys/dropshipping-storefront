# Public Supabase project values only; never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If your Supabase project uses the publishable-key convention, use this instead of the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Confirmed storefront brand; change only if the owner later rebrands.
NEXT_PUBLIC_STORE_NAME=NEXTVO
NEXT_PUBLIC_STORE_CURRENCY=NGN
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Set the actual HTTPS production URL; indexing is disabled unless both values are valid.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
