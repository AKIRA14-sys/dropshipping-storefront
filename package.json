{
  "name": "dropshipping-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first AKIRA STORE customer storefront built with Next.js and Supabase-ready data access.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"README.md\" \"docs/**/*.md\" \"tests/**/*.md\" \"*.{json,ts,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"README.md\" \"docs/**/*.md\" \"tests/**/*.md\" \"*.{json,ts,mjs}\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
